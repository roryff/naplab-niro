<?xml version="1.0"?>
<robot name="kia_niro_ev">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_control/meshes/kia_niro.glb"/>
      </geometry>
    </visual>
  </link>

  <!-- Cameras (robot-convention frames: X=viewing direction, Z=up) -->
  <link name="camera_front"/>
  <joint name="base_link_to_camera_front" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front"/>
    <origin xyz="1.608429 0.014287 1.726508" rpy="0.0 0.0 0.0"/>
  </joint>
  <link name="camera_left"/>
  <joint name="base_link_to_camera_left" type="fixed">
    <parent link="base_link"/>
    <child link="camera_left"/>
    <origin xyz="1.585977 0.575568 1.729332" rpy="0.0 0.0 1.570796"/>
  </joint>
  <link name="camera_rear"/>
  <joint name="base_link_to_camera_rear" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear"/>
    <origin xyz="0.100731 -0.008757 1.724944" rpy="0.0 0.0 3.141593"/>
  </joint>
  <link name="camera_right"/>
  <joint name="base_link_to_camera_right" type="fixed">
    <parent link="base_link"/>
    <child link="camera_right"/>
    <origin xyz="1.585872 -0.583342 1.72477" rpy="0.0 0.0 -1.570796"/>
  </joint>

  <!-- Camera optical frames: Z=viewing direction, Y=down (ROS camera_info convention) -->
  <!-- rpy=(-pi/2, 0, -pi/2) rotates so that child-Z aligns with parent-X (viewing dir) -->
  <link name="camera_front_optical"/>
  <joint name="camera_front_to_optical" type="fixed">
    <parent link="camera_front"/>
    <child link="camera_front_optical"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0.0 -1.570796"/>
  </joint>
  <link name="camera_left_optical"/>
  <joint name="camera_left_to_optical" type="fixed">
    <parent link="camera_left"/>
    <child link="camera_left_optical"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0.0 -1.570796"/>
  </joint>
  <link name="camera_rear_optical"/>
  <joint name="camera_rear_to_optical" type="fixed">
    <parent link="camera_rear"/>
    <child link="camera_rear_optical"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0.0 -1.570796"/>
  </joint>
  <link name="camera_right_optical"/>
  <joint name="camera_right_to_optical" type="fixed">
    <parent link="camera_right"/>
    <child link="camera_right_optical"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0.0 -1.570796"/>
  </joint>

  <!-- GNSS antenna -->
  <link name="gps"/>
  <joint name="base_link_to_gps" type="fixed">
    <parent link="base_link"/>
    <child link="gps"/>
    <origin xyz="0.315595 0.001153 1.549018" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- IMU (u-blox F9R internal IMU, co-located with GPS receiver) -->
  <link name="imu"/>
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="0.315595 0.001153 1.549018" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- LiDAR side (side/rear, 192.168.2.181) -->
  <link name="lidar_side/os_sensor"/>
  <joint name="base_link_to_lidar_side_os_sensor" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_side/os_sensor"/>
    <origin xyz="-0.579812 -0.820105 0.854643" rpy="0.0 0.0 -0.628322"/>
  </joint>
  <link name="lidar_side/os_lidar"/>
  <joint name="lidar_side_os_sensor_to_os_lidar" type="fixed">
    <parent link="lidar_side/os_sensor"/>
    <child link="lidar_side/os_lidar"/>
    <origin xyz="0.0 0.0 0.03618" rpy="0.0 0.0 3.141593"/>
  </joint>
  <link name="lidar_side/os_imu"/>
  <joint name="lidar_side_os_sensor_to_os_imu" type="fixed">
    <parent link="lidar_side/os_sensor"/>
    <child link="lidar_side/os_imu"/>
    <origin xyz="0.006253 -0.011775 0.007645" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- LiDAR top (top/roof, 192.168.2.205) -->
  <link name="lidar_top/os_sensor"/>
  <joint name="base_link_to_lidar_top_os_sensor" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_top/os_sensor"/>
    <origin xyz="0.738882 0.006653 1.912894" rpy="0.053872 0.025846 0.000696"/>
  </joint>
  <link name="lidar_top/os_lidar"/>
  <joint name="lidar_top_os_sensor_to_os_lidar" type="fixed">
    <parent link="lidar_top/os_sensor"/>
    <child link="lidar_top/os_lidar"/>
    <!-- z=0.0743 matches original Ouster driver calibration from source bag -->
    <origin xyz="0.0 0.0 0.0743" rpy="0.0 0.0 3.141593"/>
  </joint>
  <link name="lidar_top/os_imu"/>
  <joint name="lidar_top_os_sensor_to_os_imu" type="fixed">
    <parent link="lidar_top/os_sensor"/>
    <child link="lidar_top/os_imu"/>
    <origin xyz="0.006253 -0.011775 0.007645" rpy="0.0 0.0 0.0"/>
  </joint>
</robot>